{
  "name": "veil-obsidian-plugin",
  "version": "1.2.1",
  "description": "A configurable local wallpaper layer for Obsidian workspaces.",
  "main": "main.js",
  "private": true,
  "type": "module",
  "keywords": ["obsidian", "wallpaper", "background", "video"],
  "license": "GPL-3.0-only",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
    "lint": "eslint .",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run lint && npm run test && npm run build",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^22.15.17",
    "esbuild": "0.25.5",
    "eslint": "^9.39.4",
    "eslint-plugin-obsidianmd": "^0.4.0",
    "globals": "^17.6.0",
    "jiti": "^2.6.1",
    "obsidian": "latest",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.59.1"
  },
  "engines": {
    "node": ">=20"
  }
}
